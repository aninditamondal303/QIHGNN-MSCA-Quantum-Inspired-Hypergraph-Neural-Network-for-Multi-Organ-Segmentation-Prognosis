{
  "version": "2.0.0",
  "windows": {
    "options": {
      "shell": {
        "executable": "powershell.exe",
        "args": [
          "-NoProfile",
          "-Command"
        ]
      }
    }
  },
  "tasks": [
    {
      "label": "Kaggle: liver + cervix - wait and download",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts\\kaggle_run.ps1 -Mode train -Job organs -WaitOnly",
      "problemMatcher": []
    },
    {
      "label": "Kaggle: 3D model - wait and download",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts\\kaggle_run.ps1 -Mode train -Job main -WaitOnly",
      "problemMatcher": []
    },
    {
      "label": "Kaggle: screening models - wait and download",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts\\kaggle_run.ps1 -Mode train -Job screen -WaitOnly",
      "problemMatcher": []
    },
    {
      "label": "Kaggle: liver + cervix - train (GPU)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts\\kaggle_run.ps1 -Mode train -Job organs",
      "problemMatcher": []
    },
    {
      "label": "Kaggle: liver + cervix - rehearse training (CPU)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts\\kaggle_run.ps1 -Mode probe-train -Job organs",
      "problemMatcher": []
    },
    {
      "label": "Kaggle: liver + cervix - inspect data (CPU, minutes)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts\\kaggle_run.ps1 -Mode probe -Job organs",
      "problemMatcher": []
    },
    {
      "label": "Kaggle: screening models - train (GPU, about 2 h)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts\\kaggle_run.ps1 -Mode train -Job screen",
      "problemMatcher": []
    },
    {
      "label": "Kaggle: screening models - probe (CPU, minutes)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts\\kaggle_run.ps1 -Mode probe -Job screen",
      "problemMatcher": []
    },
    {
      "label": "Windows: one-time setup",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts\\setup_windows.ps1",
      "problemMatcher": []
    },
    {
      "label": "Windows: run all checks",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts\\run_checks.ps1",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "1. Setup: Python environment",
      "type": "shell",
      "command": "python3 -m venv .venv && .venv/bin/python -m pip install -r ml/requirements-dev.txt",
      "windows": {
        "command": "py -3 -m venv .venv; .venv\\Scripts\\python -m pip install --upgrade pip; .venv\\Scripts\\python -m pip install torch --index-url https://download.pytorch.org/whl/cpu; .venv\\Scripts\\python -m pip install -r ml/requirements-dev.txt"
      },
      "linux": {
        "command": "python3 -m venv .venv && .venv/bin/python -m pip install --upgrade pip && .venv/bin/python -m pip install torch --index-url https://download.pytorch.org/whl/cpu && .venv/bin/python -m pip install -r ml/requirements-dev.txt"
      },
      "osx": {
        "command": "python3 -m venv .venv && .venv/bin/python -m pip install --upgrade pip && .venv/bin/python -m pip install torch && .venv/bin/python -m pip install -r ml/requirements-dev.txt"
      },
      "problemMatcher": []
    },
    {
      "label": "2. Setup: web dependencies",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "problemMatcher": []
    },
    {
      "label": "Verify maths and export site data",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m qihgnn.verify; ${command:python.interpreterPath} -m qihgnn.export_web",
      "options": {
        "cwd": "${workspaceFolder}/ml"
      },
      "problemMatcher": [],
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m qihgnn.verify; ${workspaceFolder}\\.venv\\Scripts\\python.exe -m qihgnn.export_web"
      }
    },
    {
      "label": "Start API (port 8765)",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m uvicorn api.app:app --reload --port 8765",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^x"
        },
        "background": {
          "activesBegin": ".",
          "beginsPattern": "Will watch|Started reloader",
          "endsPattern": "Application startup complete|Uvicorn running"
        }
      },
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m uvicorn api.app:app --reload --port 8765"
      }
    },
    {
      "label": "Start website (port 5173)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^x"
        },
        "background": {
          "activesBegin": ".",
          "beginsPattern": ".",
          "endsPattern": "QIHGNN-MSCA web"
        }
      }
    },
    {
      "label": "Start everything",
      "dependsOn": [
        "Start API (port 8765)",
        "Start website (port 5173)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Test: Python",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m pytest",
      "group": "test",
      "problemMatcher": [],
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m pytest"
      }
    },
    {
      "label": "Test: web (unit + typecheck)",
      "type": "shell",
      "command": "npm test; npm run typecheck",
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "group": "test",
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "Test: browser end to end",
      "type": "shell",
      "command": "npm run build; npx playwright install chromium; npm run test:e2e",
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Train: smoke run (CPU, minutes)",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m qihgnn.train --config configs/smoke.json",
      "options": {
        "cwd": "${workspaceFolder}/ml"
      },
      "problemMatcher": [],
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m qihgnn.train --config configs/smoke.json"
      }
    },
    {
      "label": "Git: commit all changes",
      "type": "shell",
      "command": "git config user.name 'Anindita Mondal'; git config user.email 'aninditamondal303@gmail.com'; git add -A; git commit -m 'Publish the Pap smear cytology model with measured results; liver tumour stage on cleaned labels and original CT scans' -m 'Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>' -m 'Claude-Session: https://claude.ai/code/session_015mMNjGnUhSi1xSA9WipG7t'; git log --oneline -3; git status --short",
      "problemMatcher": []
    },
    {
      "label": "Git: push to GitHub (aninditamondal303/qihgnn-msca)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts\\github_publish.ps1",
      "problemMatcher": []
    },
    {
      "label": "GitHub: publish website on GitHub Pages",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts\\github_pages.ps1",
      "problemMatcher": []
    },
    {
      "label": "Kaggle: show GPU quota",
      "type": "shell",
      "command": "& \"${workspaceFolder}\\.venv\\Scripts\\python.exe\" -m kaggle quota 2>&1 | Tee-Object -FilePath kaggle_quota.log",
      "problemMatcher": []
    },
    {
      "label": "Kaggle: probe data loaders (CPU, minutes)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts\\kaggle_run.ps1 -Mode probe",
      "problemMatcher": []
    },
    {
      "label": "Kaggle: train and evaluate (GPU, hours)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts\\kaggle_run.ps1 -Mode train",
      "problemMatcher": []
    },
    {
      "label": "Docker: build and run production image (port 7860)",
      "type": "shell",
      "command": "docker build -t qihgnn-msca . ; docker run --rm -p 7860:7860 qihgnn-msca",
      "problemMatcher": []
    }
  ]
}